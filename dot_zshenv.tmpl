export AMIR_GITHUB_TOKEN={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/GH PAT/token" | quote }}
export YOGEV_GITHUB_TOKEN={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/YOGEV_GITHUB_TOKEN/token" | quote }}
export ISHAI_GITHUB_TOKEN={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/ISHAI_GITHUB_TOKEN/token" | quote }}
export HOMEBREW_GITHUB_API_TOKEN=$AMIR_GITHUB_TOKEN
export DRATA_TOKEN={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/Drata/token" | quote }}
export PAGERDUTY_TOKEN={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/PagerDuty/token" | quote }}
export DD_API_KEY={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/Datadog/api_key" | quote }}
export DD_APP_KEY={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/Datadog/app_key" | quote }}
