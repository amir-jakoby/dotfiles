export GOPRIVATE='REDACTED'

export PATH="/opt/homebrew/bin:$PATH"

# Add homebrew and granted completions to fpath BEFORE compinit runs
fpath=(
  /opt/homebrew/share/zsh/site-functions
  ~/.granted/zsh_autocomplete/assume
  ~/.granted/zsh_autocomplete/granted
  $fpath
)

# Granted (AWS SSO profile switcher)
alias assume=". assume"
. "$HOME/.cargo/env"
