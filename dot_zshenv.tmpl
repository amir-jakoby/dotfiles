export OP_SERVICE_ACCOUNT_TOKEN=$SAWMILLS_OP_SERVICE_ACCOUNT_TOKEN
export LAUNCHDARKLY_ACCESS_TOKEN={{ onepasswordRead "op://twc5qlrgqquiaworifv5eczvhy/LaunchDarkly Access Token/credential" | quote }}

# ============================================================================
# Private environment variables (from 1Password via chezmoi)
# ============================================================================

[[ -s "$HOME/.env.private" ]] && source "$HOME/.env.private"

# ============================================================================
# Clerk org IDs (cached — run `clerk-refresh-orgs` to update)
# ============================================================================

[[ -s "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/clerk-orgs.zsh" ]] && \
  source "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/clerk-orgs.zsh"

# ============================================================================
# Environment variables
# ============================================================================

export PATH="/opt/homebrew/bin:$PATH"

# Add homebrew and granted completions to fpath BEFORE compinit runs
fpath=(
  /opt/homebrew/share/zsh/site-functions
  ~/.granted/zsh_autocomplete/assume
  ~/.granted/zsh_autocomplete/granted
  $fpath
)

# Rust/Cargo
[[ -s "$HOME/.cargo/env" ]] && . "$HOME/.cargo/env"

# Bun global binaries (for Bun-installed CLIs like opencode, ast-grep, comment-checker)
export PATH="$HOME/.bun/bin:$PATH"
