# Fast boot: defer optional Prezto modules.
export ZSH_FAST_BOOT=1

function {
  export DOTFILES="${HOME}/.dotfiles"
  #
  # Zprezto
  #

  # Load zprezto if it's installed
  if [[ -s "${ZDOTDIR:-$HOME}/.zprezto/init.zsh" ]]; then
    source "${ZDOTDIR:-$HOME}/.zprezto/init.zsh"
  fi

  for config (~/.zsh/*.zsh) source "${config}"
}

# Load optional Prezto modules shortly after prompt is ready.
prezto-load-extras() {
  if (( $+functions[pmodload] )) && (( ${#prezto_extra_modules[@]} )); then
    pmodload "${prezto_extra_modules[@]}"
  fi
  unfunction prezto-load-extras
}
if zmodload -i zsh/sched; then
  sched +1 prezto-load-extras
else
  prezto-load-extras
fi

