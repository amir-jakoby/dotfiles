_pipenv() {
  eval $(env COMMANDLINE="${words[1,$CURRENT]}" _PIPENV_COMPLETE=complete-zsh  pipenv)
}
if [[ "$(basename ${(%):-%x})" != "_pipenv" ]]; then
  (( $+functions[compdef] )) && compdef _pipenv pipenv
fi

# Lazy-load jenv to avoid startup cost.
if command -v jenv >/dev/null; then
  jenv() {
    unset -f jenv
    __lazy_source "$ZSH_LAZY_DIR/jenv.zsh" __jenv_lazy_init
    jenv "$@"
  }
fi

# Lazy-load conda/pyenv when entering Python projects.
autoload -Uz add-zsh-hook
__python_dir_lazy() {
  if [[ -f pyproject.toml || -f requirements.txt || -f Pipfile || -f setup.py || -d .venv || -f environment.yml || -f .python-version ]]; then
    [[ -z ${__python_dir_bootstrapped:-} ]] || return 0
    __python_dir_bootstrapped=1
    __lazy_source "$ZSH_LAZY_DIR/pyenv.zsh" __pyenv_lazy_init
    __lazy_source "$ZSH_LAZY_DIR/conda.zsh" __conda_lazy_init
  fi
}
add-zsh-hook chpwd __python_dir_lazy
__python_dir_lazy

