ZSH_LAZY_DIR="${ZDOTDIR:-$HOME}/.zsh/lazy"
autoload -Uz add-zsh-hook

__lazy_source() {
  local file=$1 init=$2
  [[ -r "$file" ]] && source "$file"
  (( $+functions[$init] )) && "$init"
}

__path_prepend() {
  local dir=$1
  [[ -n "$dir" ]] || return 0
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$dir:$PATH" ;;
  esac
}

__path_append() {
  local dir=$1
  [[ -n "$dir" ]] || return 0
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$PATH:$dir" ;;
  esac
}

__path_prepend "$HOME/Code/sawmills-cli/target/debug"

typeset -ga ZSH_DEFERRED_COMPLETION_FILES=()

__queue_completion_file() {
  local file=$1
  [[ -s "$file" ]] || return 0
  ZSH_DEFERRED_COMPLETION_FILES+=("$file")
}

__load_deferred_completions() {
  (( $+functions[compdef] )) || return 0

  local file
  for file in "${ZSH_DEFERRED_COMPLETION_FILES[@]}"; do
    source "$file"
  done
  ZSH_DEFERRED_COMPLETION_FILES=()

  if [[ -s "$HOME/.zsh/completions/_new-task" ]]; then
    autoload -Uz _new_task
    (( $+functions[_new_task] )) && compdef _new_task new-task
  fi

  if [[ -x "$HOME/Code/sawmills-cli/target/release/sm" ]]; then
    (( $+functions[_sm] )) && compdef _sm "$HOME/Code/sawmills-cli/target/release/sm"
  fi

  (( $+functions[_opencode_yargs_completions] )) && compdef _opencode_yargs_completions opencode
  (( $+functions[_pipenv] )) && compdef _pipenv pipenv
  add-zsh-hook -d precmd __load_deferred_completions 2>/dev/null
}

__refresh_completion_cache() {
  local cmd=$1 file=$2 force=${3:-0}
  (( $+commands[$cmd] )) || return 0
  if (( force )) || [[ ! -s "$file" ]]; then
    "$cmd" completion zsh >| "$file" 2>/dev/null
  fi
}

zsh-refresh-completions() {
  __refresh_completion_cache kubectl "$ZSH_COMPLETIONS_DIR/_kubectl" 1
  __refresh_completion_cache atmos "$ZSH_COMPLETIONS_DIR/_atmos" 1
  __refresh_completion_cache drata "$ZSH_COMPLETIONS_DIR/_drata" 1
  __refresh_completion_cache remote-operator "$ZSH_COMPLETIONS_DIR/_remote-operator" 1
  # sm: skip auto-refresh - dev build in target/debug changes constantly (1.5s to generate)
  # Run manually when needed: sm completion zsh >| "$ZSH_COMPLETIONS_DIR/_sm"
  if [[ -x "$HOME/.opencode/bin/opencode" ]] || (( $+commands[opencode] )); then
    "$HOME/.opencode/bin/opencode" completion >| "$ZSH_COMPLETIONS_DIR/_opencode" 2>/dev/null
  fi
  if (( $+commands[clerk] )); then
    clerk completions zsh >| "$ZSH_COMPLETIONS_DIR/_clerk" 2>/dev/null
  fi
}

