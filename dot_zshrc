if command -v go >/dev/null; then
  go() {
    unset -f go
    local new_gopath
    new_gopath="$(command go env GOPATH 2>/dev/null)"
    if [[ -n "$new_gopath" && "$new_gopath" != "$GOPATH" ]]; then
      export GOPATH="$new_gopath"
      mkdir -p "${ZSH_GOPATH_CACHE:h}"
      printf '%s' "$GOPATH" >| "$ZSH_GOPATH_CACHE"
      __path_append "$GOPATH/bin"
    fi
    go "$@"
  }
fi

