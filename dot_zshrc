_fix_ssh_auth_sock() {
  [[ -n "$TMUX" ]] || return

  local line sock
  line="$(tmux showenv SSH_AUTH_SOCK 2>/dev/null)" || return
  [[ "$line" == -* ]] && return

  sock="${line#SSH_AUTH_SOCK=}"
  [[ -S "$sock" ]] || return

  export SSH_AUTH_SOCK="$sock"
}

_init_tmux_prompt_context() {
  [[ -n "$TMUX" ]] || return
  [[ -n "${STARSHIP_TMUX_SESSION:-}" ]] && return

  local session
  session="$(tmux display-message -p '#S' 2>/dev/null)" || return
  [[ -n "$session" ]] || return
  export STARSHIP_TMUX_SESSION="$session"
}

