# Lazy-load conda/pyenv when entering Python projects.
__python_dir_lazy() {
  if [[ -f pyproject.toml || -f requirements.txt || -f Pipfile || -f setup.py || -d .venv || -f environment.yml || -f .python-version ]]; then
    [[ -z ${__python_dir_bootstrapped:-} ]] || return 0
    __python_dir_bootstrapped=1
    __lazy_source "$ZSH_LAZY_DIR/pyenv.zsh" __pyenv_lazy_init
    __lazy_source "$ZSH_LAZY_DIR/conda.zsh" __conda_lazy_init
  fi
}
