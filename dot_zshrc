# Cache expensive completions to avoid running them on every shell start.
ZSH_COMPLETIONS_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/completions"
mkdir -p "$ZSH_COMPLETIONS_DIR"
ZSH_LAZY_DIR="${ZDOTDIR:-$HOME}/.zsh/lazy"

__lazy_source() {
  local file=$1 init=$2
  [[ -r "$file" ]] && source "$file"
  (( $+functions[$init] )) && "$init"
}

__path_prepend() {
  local dir=$1
  [[ -n "$dir" ]] || return 0
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$dir:$PATH" ;;
  esac
}

__path_append() {
  local dir=$1
  [[ -n "$dir" ]] || return 0
  case ":$PATH:" in
    *":$dir:"*) ;;
    *) PATH="$PATH:$dir" ;;
  esac
}

__path_prepend "$HOME/Code/sawmills-cli/target/debug"

__update_completion() {
  local cmd=$1 file=$2
  (( $+commands[$cmd] )) || return 0
  if [[ ! -s "$file" || "$commands[$cmd]" -nt "$file" ]]; then
    "$cmd" completion zsh >| "$file" 2>/dev/null
  fi
}

__update_completion kubectl "$ZSH_COMPLETIONS_DIR/_kubectl"
__update_completion atmos "$ZSH_COMPLETIONS_DIR/_atmos"
__update_completion drata "$ZSH_COMPLETIONS_DIR/_drata"
# sm: skip auto-update - dev build in target/debug changes constantly (1.5s to generate)
# Run manually: sm completion zsh >| "$ZSH_COMPLETIONS_DIR/_sm"

[[ -s "$ZSH_COMPLETIONS_DIR/_kubectl" ]] && source "$ZSH_COMPLETIONS_DIR/_kubectl"
[[ -s "$ZSH_COMPLETIONS_DIR/_atmos" ]] && source "$ZSH_COMPLETIONS_DIR/_atmos"
[[ -s "$ZSH_COMPLETIONS_DIR/_drata" ]] && source "$ZSH_COMPLETIONS_DIR/_drata"
[[ -s "$ZSH_COMPLETIONS_DIR/_sm" ]] && source "$ZSH_COMPLETIONS_DIR/_sm"
if [[ -x "$HOME/Code/sawmills-cli/target/release/sm" ]]; then
  (( $+functions[_sm] )) && compdef _sm "$HOME/Code/sawmills-cli/target/release/sm"
fi

# clerk uses 'completions' not 'completion'
