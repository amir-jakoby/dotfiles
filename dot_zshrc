ZSH_GOPATH_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/gopath"
if [[ -r "$ZSH_GOPATH_CACHE" ]]; then
  export GOPATH="$(<"$ZSH_GOPATH_CACHE")"
else
  export GOPATH="${GOPATH:-$HOME/go}"
fi
__path_append "$GOPATH/bin"
__path_append "$HOME/Code/sandbox/bin"
__path_prepend "$HOME/dotfiles/bin/bin"

if command -v go >/dev/null; then
  go() {
    unset -f go
    local new_gopath
    new_gopath="$(command go env GOPATH 2>/dev/null)"
    if [[ -n "$new_gopath" && "$new_gopath" != "$GOPATH" ]]; then
      export GOPATH="$new_gopath"
      mkdir -p "${ZSH_GOPATH_CACHE:h}"
      printf '%s' "$GOPATH" >| "$ZSH_GOPATH_CACHE"
      __path_append "$GOPATH/bin"
    fi
    go "$@"
  }
fi

